<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenCV 공통 설정 (모든 단원 프로젝트에서 공유)
  사용법: VS 속성 관리자(Property Manager) → 프로젝트 우클릭 → "기존 속성 시트 추가" → 이 파일 선택

  전제: 환경변수 OPENCV_DIR = OpenCV의 build 폴더 (예: C:\opencv\build)
  아래 두 값은 설치한 OpenCV에 맞게 한 번만 수정할 것
    - OpenCVVer : lib 파일명의 숫자 (opencv_world4100.lib 이면 4100)
    - OpenCVVc  : build\x64 아래 폴더명 (vc16 / vc17 등)
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <OpenCVVer>4100</OpenCVVer>
    <OpenCVVc>vc16</OpenCVVc>
  </PropertyGroup>

  <!-- 디버깅 실행 시 OpenCV dll을 찾을 수 있도록 PATH 추가 (dll을 프로젝트 폴더에 복사할 필요 없음) -->
  <PropertyGroup>
    <LocalDebuggerEnvironment>PATH=$(OPENCV_DIR)\x64\$(OpenCVVc)\bin;%PATH%</LocalDebuggerEnvironment>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(OPENCV_DIR)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(OPENCV_DIR)\x64\$(OpenCVVc)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!-- Debug 빌드는 끝에 d가 붙은 lib 사용 -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <Link>
      <AdditionalDependencies>opencv_world$(OpenCVVer)d.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <Link>
      <AdditionalDependencies>opencv_world$(OpenCVVer).lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
